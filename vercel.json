{
  "rewrites": [
    { "source": "/for-freelancers", "destination": "/for-freelancers.html" },
    { "source": "/for-agencies", "destination": "/for-agencies.html" },
    { "source": "/nl", "destination": "/nl.html" },
    { "source": "/es", "destination": "/es.html" },
    { "source": "/fr", "destination": "/fr.html" },
    { "source": "/ubl-factuur-maken", "destination": "/ubl-factuur-maken.html" },
    { "source": "/fr/relance-facture-impayee-anglais", "destination": "/relance-facture-impayee-anglais.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/app", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/login", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/register", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/reset-password", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/ambassador", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/pay/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "crons": [{
    "path": "/api/trial-reminder",
    "schedule": "0 9 * * *"
  }, {
    "path": "/api/cron-recurring",
    "schedule": "0 6 * * *"
  }]
}
