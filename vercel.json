{
  "buildCommand": "npm run build",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/for-freelancers.html", "destination": "/for-freelancers", "permanent": true },
    { "source": "/for-agencies.html", "destination": "/for-agencies", "permanent": true },
    { "source": "/nl.html", "destination": "/nl", "permanent": true },
    { "source": "/es.html", "destination": "/es", "permanent": true },
    { "source": "/fr.html", "destination": "/fr", "permanent": true },
    { "source": "/ar.html", "destination": "/ar", "permanent": true },
    { "source": "/ar-invoicing-europe.html", "destination": "/ar/invoicing-netherlands-germany-belgium", "permanent": true },
    { "source": "/ubl-factuur-maken.html", "destination": "/ubl-factuur-maken", "permanent": true },
    { "source": "/relance-facture-impayee-anglais.html", "destination": "/fr/relance-facture-impayee-anglais", "permanent": true }
  ],
  "rewrites": [
    { "source": "/for-freelancers", "destination": "/for-freelancers.html" },
    { "source": "/for-agencies", "destination": "/for-agencies.html" },
    { "source": "/nl", "destination": "/nl.html" },
    { "source": "/es", "destination": "/es.html" },
    { "source": "/fr", "destination": "/fr.html" },
    { "source": "/ar", "destination": "/ar.html" },
    { "source": "/ar/invoicing-netherlands-germany-belgium", "destination": "/ar-invoicing-europe.html" },
    { "source": "/ubl-factuur-maken", "destination": "/ubl-factuur-maken.html" },
    { "source": "/fr/relance-facture-impayee-anglais", "destination": "/relance-facture-impayee-anglais.html" },
    { "source": "/login", "destination": "/app-shell.html" },
    { "source": "/register", "destination": "/app-shell.html" },
    { "source": "/reset-password", "destination": "/app-shell.html" },
    { "source": "/privacy", "destination": "/app-shell.html" },
    { "source": "/terms", "destination": "/app-shell.html" },
    { "source": "/ambassador-terms", "destination": "/app-shell.html" },
    { "source": "/blog", "destination": "/app-shell.html" },
    { "source": "/api-docs", "destination": "/app-shell.html" },
    { "source": "/late-payment-scripts", "destination": "/app-shell.html" },
    { "source": "/ambassadors", "destination": "/app-shell.html" },
    { "source": "/ambassador", "destination": "/app-shell.html" },
    { "source": "/invoice-generator", "destination": "/app-shell.html" },
    { "source": "/admin", "destination": "/app-shell.html" },
    { "source": "/app", "destination": "/app-shell.html" },
    { "source": "/blog/how-to-create-ubl-invoice-en16931", "destination": "/app-shell.html" },
    { "source": "/blog/fatura-pro-plan-guide-how-to-use", "destination": "/app-shell.html" },
    { "source": "/blog/fatura-business-plan-guide-how-to-use", "destination": "/app-shell.html" },
    { "source": "/blog/invoicing-plans-free-vs-pro-vs-business", "destination": "/app-shell.html" },
    { "source": "/blog/best-invoicing-software-small-agencies", "destination": "/app-shell.html" },
    { "source": "/blog/best-invoicing-app-arabic-support", "destination": "/app-shell.html" },
    { "source": "/blog/zzp-invoice-app-english-netherlands", "destination": "/app-shell.html" },
    { "source": "/blog/how-to-create-professional-invoice", "destination": "/app-shell.html" },
    { "source": "/blog/how-to-create-professional-invoice-arabic", "destination": "/app-shell.html" },
    { "source": "/pay/:invoiceId", "destination": "/app-shell.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/app", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/login", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/register", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/reset-password", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/ambassador", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/pay/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "crons": [{
    "path": "/api/trial-reminder",
    "schedule": "0 9 * * *"
  }, {
    "path": "/api/cron-recurring",
    "schedule": "0 6 * * *"
  }]
}
